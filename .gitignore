# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# photos uploaded through the owner form at runtime. The seed-*.svg
# illustrations that ship with the repo are deliberately not ignored.
/public/turf-photos/upload-*

# local sqlite database — src/lib/db.ts creates and seeds this on first run,
# so a fresh clone builds its own with dates relative to today. The -wal/-shm
# files are transient SQLite journals and must never be committed.
turf.db
turf.db-shm
turf.db-wal
