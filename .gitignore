# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example must be committed: it documents what DATABASE_URL is and
# contains no real credentials.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# photos uploaded through the owner form at runtime. The seed-*.svg
# illustrations that ship with the repo are deliberately not ignored.
/public/turf-photos/upload-*

# Leftover SQLite files from before the move to Postgres. Nothing writes these
# any more, but an old working copy may still have them — keep them out of git.
turf.db
turf.db-shm
turf.db-wal

# Neon CLI agent-skill docs, downloaded on demand. Same reasoning as
# node_modules: the lockfile (skills-lock.json) is committed, the fetched
# content is not.
/.agents/
