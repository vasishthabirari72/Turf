# Copy this file to .env.local and fill in a real connection string.
# .env.local is gitignored — never commit real credentials.

# Required. Any Postgres will do; Neon's free tier is what this is set up for.
# Get it from the Neon dashboard: Project -> Connection Details -> Connection string.
# Use the POOLED connection string (the host contains "-pooler") for serverless.
#
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#
# For a local Postgres instead:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/maidaanconnect
DATABASE_URL=

# Required. Encrypts the session cookie (iron-session). Must be at least 32
# characters — the app refuses to start without it rather than falling back to
# a default, since a known secret means anyone can forge a session.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every existing session, i.e. signs everyone out.
SESSION_PASSWORD=

# Turf photo storage. Create one and link it to the project with:
#   npx vercel blob create-store maidaanconnect-photos --access public --yes
# which writes the token into .env.local for you.
#
# Without it the upload route falls back to writing public/turf-photos on local
# disk. That is fine for development and CANNOT work on a serverless host, where
# the filesystem is read-only -- uploads there fail until this is set.
BLOB_READ_WRITE_TOKEN=

# Razorpay payments. Optional: without these the checkout falls back to the
# mock payment sheet, so the demo still runs end to end on a fresh clone.
# Get test keys from the Razorpay Dashboard -> Settings -> API Keys. Test mode
# moves no real money; the card 4111 1111 1111 1111 always succeeds.
#
# KEY_SECRET signs orders and verifies payment signatures. It must stay on the
# server -- anyone holding it can forge a "payment verified" signature, so it is
# never prefixed NEXT_PUBLIC_ and never reaches the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# The same key id again, deliberately duplicated. Razorpay Checkout runs in the
# browser and needs it there, and only NEXT_PUBLIC_ vars are sent to the client.
# A key id is public by design -- it identifies the account, it does not authorise
# anything on its own.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# After setting the above, once:
#   npm run migrate    # create tables (idempotent, safe to re-run)
#   npm run seed       # demo data, refuses if the database already has turfs
